{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClosePluginView",
  "type": "object",
  "properties": {
    "mode": {
      "$ref": "#/$defs/PluginViewCloseMode",
      "default": {
        "kind": "cooperate"
      }
    },
    "view": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "view"
  ],
  "$defs": {
    "PluginViewCloseMode": {
      "oneOf": [
        {
          "description": "Each registered participant confirms its owner-defined preparation.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cooperate"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Explicitly detach this observed connection, or a retained detached view.\nThis does not establish that content was saved or native work stopped.",
          "type": "object",
          "properties": {
            "connection": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "disconnect"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}